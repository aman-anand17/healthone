# TEMPLATE ONLY. Copy the shape, never commit the values.
#
# For Streamlit Community Cloud: paste the filled-in version into the app's
# Advanced settings -> Secrets box in the Community Cloud UI. It is stored
# there, encrypted, and never reaches this repository.
#
# For a local run you would put the filled-in version at
# .streamlit/secrets.toml - which .gitignore already blocks.
#
# ROLE MATTERS. Use HO_REVIEWER, not ACCOUNTADMIN. The product's central
# claim is that a reviewer sees masked patient data and must break the
# glass deliberately; an admin role would show names in clear and
# demonstrate the opposite of what the app says about itself.

[snowflake]
account   = "<ORGNAME-ACCOUNTNAME>"   # Snowsight: your name -> account ->
                                     # copy account identifier
user      = "HO_PUBLIC_APP"
password  = "<the password you set with ALTER USER, never reused>"
role      = "HO_REVIEWER"
warehouse = "HO_WH"
database  = "HEALTHONE"
schema    = "APP"

# Key-pair instead of a password, if you prefer. Paste the whole PEM,
# including the BEGIN/END lines, as a TOML multi-line string:
# private_key = """-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----"""
